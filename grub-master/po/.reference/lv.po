#: grub-core/commands/acpi.c:57
msgid "Don't load host tables specified by comma-separated list."
msgstr "Neielādēt ar komatiem atdalītā sarakstā norādītās resursdatora tabulas."

#: grub-core/commands/acpi.c:60
msgid "Load only tables specified by comma-separated list."
msgstr "Ielādēt tikai ar komatiem atdalītā sarakstā norādītās tabulas."

#: grub-core/commands/acpi.c:61
msgid "Export version 1 tables to the OS."
msgstr "Eksportēt 1. versijas tabulas uz operētājsistēmu."

#: grub-core/commands/acpi.c:62
msgid "Export version 2 and version 3 tables to the OS."
msgstr "Eksportēt 2. un 3. versijas tabulas uz operētājsistēmu."

#: grub-core/commands/acpi.c:63
msgid "Set OEMID of RSDP, XSDT and RSDT."
msgstr "Iestatīt RSDP, XSDT un RSDT OEMID."

#: grub-core/commands/acpi.c:65
msgid "Set OEMTABLE ID of RSDP, XSDT and RSDT."
msgstr "Iestatīt OEMTABLE ID priekš RSDP, XSDT un RSDT."

#: grub-core/commands/acpi.c:67
msgid "Set OEMTABLE revision of RSDP, XSDT and RSDT."
msgstr "Iestatīt OEMTABLE revīziju RSDP, XSDT un RSDT."

#: grub-core/commands/acpi.c:69
msgid "Set creator field of RSDP, XSDT and RSDT."
msgstr "Iestatīt RSDP, XSDT un RSDT veidotāja lauku."

#: grub-core/commands/acpi.c:71
msgid "Set creator revision of RSDP, XSDT and RSDT."
msgstr "Iestatīt RSDP, XSDT un RSDT veidotāja versiju."

#. TRANSLATORS: "hangs" here is a noun, not a verb.
#: grub-core/commands/acpi.c:73
msgid "Don't update EBDA. May fix failures or hangs on some BIOSes but makes it ineffective with OS not receiving RSDP from GRUB."
msgstr "Neatjaunināt EBDA. Var novērst kļūdas vai uzkāršanos dažos BIOS, taču padara to neefektīvu ar operētājsistēmu, kas no GRUB nesaņem RSDP."

